# ==============================================================================
# Environment Variables Configuration
# Copy this file to .env and fill in your values
# ==============================================================================

# Database Connection URL (PostgreSQL / Neon Database)
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
# NOTE: The app automatically falls back to LocalStorage mode if this is left empty!
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/padel_db?sslmode=require"

# Neon Auth Endpoint (Optional, for OAuth / Better Auth authentication)
PUBLIC_NEON_AUTH_URL="https://oauth.neon.tech/your-auth-id"
